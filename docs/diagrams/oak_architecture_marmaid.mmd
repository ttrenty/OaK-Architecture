flowchart LR
  World["World"]

  subgraph Core["Core AoK agent in Sutton's original naming"]
    Perception["Perception"]
    State["State"]
    ReactivePolicy["Reactive Policy"]
    ValueFunction["Value Function"]
    TransitionModel["Transition Model"]
  end

  World -->|observation, reward| Perception
  Perception -->|produces| State
  State --> ReactivePolicy
  State --> ValueFunction
  State --> TransitionModel
  ReactivePolicy -->|action| World
  ValueFunction -->|learning signal| ReactivePolicy
  TransitionModel -->|planning signal| ReactivePolicy
  TransitionModel -->|simulated consequences| ValueFunction

  subgraph Detailed["Detailed internal OaK mechanisms"]
    FeatureConstruction["Feature Construction"]
    SubTask["SubTask"]
    OptionLearner["Option"]
    OptionModel["Option Model"]
    Planning["Planning"]
    UtilityAssessor["Utility Assessor"]
    Curator["Curator"]
    OptionKeyboard["Option Keyboard (optional)"]
  end

  State -.->|interesting features| FeatureConstruction
  FeatureConstruction -.-> SubTask
  SubTask -.-> OptionLearner
  OptionLearner -.-> OptionModel
  OptionModel -.-> TransitionModel
  TransitionModel -.-> Planning
  Planning -.-> ValueFunction
  Planning -.-> ReactivePolicy
  FeatureConstruction -.-> UtilityAssessor
  OptionLearner -.-> UtilityAssessor
  TransitionModel -.-> UtilityAssessor
  UtilityAssessor -.-> Curator
  Curator -.-> FeatureConstruction
  Curator -.-> OptionLearner
  Curator -.-> OptionModel
  OptionKeyboard -.-> ReactivePolicy
