@startuml
title OaK fine_grained: slot map of fine-grained interfaces

hide stereotype
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ranksep 70
skinparam nodesep 28

skinparam rectangle<<orchestrator>> {
  BackgroundColor #FFF7DF
  BorderColor #B45F06
  FontColor #7A4A00
  FontStyle bold
}

skinparam package<<family>> {
  BackgroundColor #FFF7DF
  BorderColor #B45F06
  FontColor #7A4A00
}

skinparam rectangle<<composite>> {
  BackgroundColor #FFE599
  BorderColor #B45F06
  FontColor #5F3B00
  FontStyle bold
}

skinparam rectangle<<support_component>> {
  BackgroundColor #F8F8F8
  BorderColor #B7B7B7
  FontColor #333333
}

skinparam rectangle<<associated_interface>> {
  BackgroundColor #FDFDFD
  BorderColor #B7B7B7
  FontColor #555555
}

rectangle "OaKAgent\ncoordinates four default slots" as agent <<orchestrator>>

package "Perception slot\nimplements Perception" as perception_slot <<family>> {
  rectangle "CompositePerception" as composite_perception <<composite>>
  rectangle "StateBuilder" as state_builder <<support_component>>
  rectangle "FeatureBank" as feature_bank <<support_component>>
  rectangle "FeatureConstructor" as feature_constructor <<support_component>>
  rectangle "FeatureRanker" as feature_ranker <<support_component>>
  rectangle "SubtaskGenerator" as subtask_generator <<support_component>>

  composite_perception --> state_builder
  composite_perception --> feature_bank
  composite_perception --> feature_constructor
  composite_perception --> feature_ranker
  composite_perception --> subtask_generator

  state_builder -[hidden]down-> feature_bank
  feature_bank -[hidden]down-> feature_constructor
  feature_constructor -[hidden]down-> feature_ranker
  feature_ranker -[hidden]down-> subtask_generator
}

package "TransitionModel slot\nimplements TransitionModel" as transition_slot <<family>> {
  rectangle "CompositeTransitionModel" as composite_transition_model <<composite>>
  rectangle "WorldModel" as world_model <<support_component>>
  rectangle "OptionModelLearner" as option_model_learner <<support_component>>
  rectangle "Planner" as planner <<support_component>>
  rectangle "OptionModel\n(associated interface)" as option_model <<associated_interface>>

  composite_transition_model --> world_model
  composite_transition_model --> option_model_learner
  composite_transition_model --> planner
  option_model_learner ..> option_model : exports
  world_model ..> option_model : consumes

  world_model -[hidden]down-> option_model_learner
  option_model_learner -[hidden]down-> planner
  planner -[hidden]down-> option_model
}

package "ValueFunction slot\nimplements ValueFunction" as value_slot <<family>> {
  rectangle "CompositeValueFunction" as composite_value_function <<composite>>
  rectangle "ValueEstimator" as value_estimator <<support_component>>
  rectangle "UtilityAssessor" as utility_assessor <<support_component>>
  rectangle "Curator" as curator <<support_component>>
  rectangle "GeneralValueFunctionLearner\n(associated interface)" as gvf_learner <<associated_interface>>
  rectangle "MetaStepSizeLearner\n(optional associated interface)" as meta_step_sizes <<associated_interface>>

  composite_value_function --> value_estimator
  composite_value_function --> utility_assessor
  composite_value_function --> curator
  value_estimator ..> gvf_learner : may own
  composite_value_function ..> meta_step_sizes : may use

  value_estimator -[hidden]down-> utility_assessor
  utility_assessor -[hidden]down-> curator
  curator -[hidden]down-> gvf_learner
  gvf_learner -[hidden]down-> meta_step_sizes
}

package "ReactivePolicy slot\nimplements ReactivePolicy" as policy_slot <<family>> {
  rectangle "CompositeReactivePolicy" as composite_reactive_policy <<composite>>
  rectangle "ActionSelector" as action_selector <<support_component>>
  rectangle "OptionLibrary" as option_library <<support_component>>
  rectangle "OptionLearner" as option_learner <<support_component>>
  rectangle "Option\n(associated interface)" as option <<associated_interface>>
  rectangle "OptionKeyboard\n(optional associated interface)" as option_keyboard <<associated_interface>>

  composite_reactive_policy --> action_selector
  composite_reactive_policy --> option_library
  composite_reactive_policy --> option_learner
  option_library ..> option : stores / returns
  option_learner ..> option : exports
  composite_reactive_policy ..> option_keyboard : optional

  action_selector -[hidden]down-> option_library
  option_library -[hidden]down-> option_learner
  option_learner -[hidden]down-> option
  option -[hidden]down-> option_keyboard
}

agent --> composite_perception : perception
agent --> composite_transition_model : transition_model
agent --> composite_value_function : value_function
agent --> composite_reactive_policy : reactive_policy

perception_slot -[hidden]right-> transition_slot
perception_slot -[hidden]down-> value_slot
transition_slot -[hidden]down-> policy_slot
value_slot -[hidden]right-> policy_slot

note bottom
Read this after oak_core.
This is a slot map of the fine-grained interfaces.
Solid arrows show the main Composite* wiring.
Dotted arrows show associated or optional interfaces that exist in the fine_grained layer
but are not necessarily touched on every step.
The per-step runtime path is expanded in oak_runtime_sequence.
end note

@enduml
