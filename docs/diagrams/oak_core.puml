@startuml
title OaK architecture: four main interfaces

top to bottom direction
hide stereotype
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowThickness 2
skinparam ranksep 70
skinparam nodesep 36

skinparam package<<agent>> {
  BackgroundColor #FFF7DF
  BorderColor #B45F06
  FontColor #7A4A00
}

skinparam rectangle<<module>> {
  BackgroundColor #FFE599
  BorderColor #B45F06
  FontColor #5F3B00
  FontStyle bold
}

skinparam artifact {
  BackgroundColor #F3F3F3
  BorderColor #999999
  FontColor #333333
}

actor world

artifact time_step
artifact "step memory\nlast_subjective_state\nlast_action" as step_memory
artifact subjective_state
artifact "transition\n(internal step record)" as transition
artifact planning_update
artifact action

package "OaKAgent\nconcrete class with a .train() method" <<agent>> {
  rectangle "Perception" as perception <<module>>
  rectangle "TransitionModel" as transition_model <<module>>
  rectangle "ValueFunction" as value_function <<module>>
  rectangle "ReactivePolicy" as reactive_policy <<module>>

  perception -[hidden]right-> transition_model
  perception -[hidden]down-> value_function
  transition_model -[hidden]down-> reactive_policy
  value_function -[hidden]right-> reactive_policy
}

time_step -[hidden]right-> step_memory
step_memory -[hidden]right-> subjective_state

world -up-> time_step
time_step -right-> perception : perceive(...)
perception --> subjective_state

step_memory --> transition
time_step -right-> transition : reward, terminated,\ninfo
subjective_state --> transition
transition --> value_function : update value estimates
transition --> transition_model : update transition model
transition --> reactive_policy : update policy

subjective_state --> transition_model
value_function --> transition_model
transition_model --> planning_update : plan
planning_update --> reactive_policy

subjective_state --> reactive_policy
reactive_policy --> action : primitive action
action -down-> world : takes action

note right of transition
Built inside OaKAgent.step(...)
only when a previous state/action exists.
end note

'note bottom
'This is the default conceptual surface of OaK:
'OaKAgent coordinates four main interfaces.
'It shows the four slots and the main data flow, not every method.
'For the fine-grained interface inventory, see oak_architecture.
'end note

@enduml
