@startuml
title OaKAgent.step(...): composite-wired runtime sequence

hide footbox
skinparam shadowing false
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam SequenceMessageAlign center

actor caller
participant OaKAgent as Agent

box "Perception slot" #FFF7DF
participant "Composite\nPerception" as CP
participant "State\nBuilder" as SB
participant "Feature\nConstructor" as FC
participant "Feature\nBank" as FB
participant "Feature\nRanker" as FR
participant "Subtask\nGenerator" as SG
end box

box "ValueFunction slot" #FFF7DF
participant "Composite\nValueFunction" as CVF
participant "Value\nEstimator" as VE
participant "Utility\nAssessor" as UA
participant "Curator" as CUR
end box

box "TransitionModel slot" #FFF7DF
participant "Composite\nTransitionModel" as CTM
participant "World\nModel" as WM
participant "OptionModel\nLearner" as OML
participant "Planner" as PL
end box

box "ReactivePolicy slot" #FFF7DF
participant "Composite\nReactivePolicy" as CRP
participant "Action\nSelector" as AS
participant "Option\nLibrary" as OLIB
participant "Option\nLearner" as OLR
participant "Option" as OPT
end box

rnote over Agent, CRP
This is the per-step call path through the Composite* implementations.
It shows the fine-grained interfaces touched during one step(...),
not every optional interface in oak_architecture.fine_grained.components.
endrnote

caller -> Agent : step(time_step)
activate Agent

== 1. Perceive ==

Agent -> CP : update(observation,\nreward,\nlast_action)
CP -> SB : update(...)
SB --> CP : subjective_state
CP --> Agent : subjective_state

== 2. Learn ==

group when a previous transition exists
  Agent -> Agent : transition = Transition(...)

  Agent -> CVF : update(transition)
  CVF -> VE : update(transition)
  VE --> CVF : td_errors
  CVF --> Agent : td_errors

  Agent -> CRP : update(transition, td_errors)
  CRP -> AS : update_from_values(next_state,\ntd_errors)
  CRP -> OLR : update(transition)

  Agent -> CTM : update(transition)
  CTM -> WM : update(transition)
  CTM -> OML : update(transition)
end

== 3. Grow ==

Agent -> CVF : utility_scores()
CVF -> UA : scores()
UA --> CVF : utility_scores
CVF --> Agent : utility_scores

Agent -> CP : discover_and_rank_features(subjective_state,\nutility_scores,\nfeature_budget)
CP -> FB : list_features()
FB --> CP : current features
CP -> FC : propose(subjective_state,\ncurrent features)
FC --> CP : candidates
group when candidates exist
  CP -> FB : add_candidates(candidates)
end
CP -> FB : list_features()
FB --> CP : current features
CP -> FR : rank(current features,\nutility_scores,\nfeature_budget)
FR --> CP : ranked_feature_ids
CP --> Agent : ranked_feature_ids

group when ranked_feature_ids is not empty
  Agent -> CP : generate_subtasks(ranked_feature_ids)
  CP -> SG : generate(ranked_feature_ids,\nfeature_bank)
  SG --> CP : created_subtasks
  CP --> Agent : created_subtasks

  group when created_subtasks is not empty
    Agent -> CRP : ingest_subtasks(created_subtasks)
    CRP -> OLR : ingest_subtasks(created_subtasks)
  end
end

Agent -> CRP : integrate_options()
CRP -> OLR : export_options()
OLR --> CRP : learned options
loop for each exported option
  CRP -> OLIB : add_or_replace(option)
end

Agent -> CTM : integrate_option_models()
CTM -> OML : export_models()
OML --> CTM : learned option models
CTM -> WM : add_or_replace_option_models(...)

== 4. Plan ==

Agent -> CTM : plan(subjective_state,\nvalue_function,\nbudget)
CTM -> PL : plan_step(subjective_state,\nworld_model,\nvalue_function_adapter,\nbudget)
PL --> CTM : planning_update
CTM --> Agent : planning_update

Agent -> CRP : apply_planning_update(planning_update)
CRP -> AS : apply_planning_update(planning_update)

== 5. Act ==

Agent -> CRP : select_action(subjective_state,\noption_stop_threshold)
alt active option continues
  CRP -> OPT : stop_probability(subjective_state)
  OPT --> CRP : stop_prob
  CRP -> OPT : act(subjective_state)
  OPT --> CRP : option action
  CRP --> Agent : (action, active_option_id)
else choose new control
  CRP -> OLIB : list_options()
  OLIB --> CRP : available options
  CRP -> AS : decide(subjective_state,\nactive_option=None,\navailable_options)
  AS --> CRP : PolicyDecision

  alt selector chose an option
    CRP -> OLIB : get(option_id)
    OLIB --> CRP : selected option
    CRP -> OPT : act(subjective_state)
    OPT --> CRP : option action
    CRP --> Agent : (action, option_id)
  else selector chose a primitive action
    CRP --> Agent : (action, None)
  end
end

== 6. Maintain ==

Agent -> Agent : usage_records = _build_usage_records(...)
group when usage_records is not empty
  Agent -> CVF : observe_usage(usage_records)
  CVF -> UA : observe(usage_records)
end

Agent -> CVF : curate()
CVF -> UA : scores()
UA --> CVF : utility_scores
CVF -> CUR : curate(utility_scores)
CUR --> CVF : curation_decision
CVF --> Agent : curation_decision

group when curation_decision drops structures
  Agent -> CP : remove_features(drop_features)
  CP -> FB : remove(drop_features)

  Agent -> CRP : remove_subtasks(drop_subtasks)
  CRP -> OLR : remove_subtasks(drop_subtasks)

  Agent -> CRP : remove_options(drop_options)
  CRP -> OLIB : remove(drop_options)

  Agent -> CTM : remove_option_models(drop_option_models)
  CTM -> WM : remove_option_models(drop_option_models)

  Agent -> CVF : remove(drop_general_value_functions)
  CVF -> VE : remove(drop_general_value_functions)
end

== Update memory ==

Agent -> Agent : self.last_subjective_state = subjective_state
Agent -> Agent : self.last_action = action

group episode boundary cleanup [when time_step.terminated or time_step.truncated]
  Agent -> CRP : clear_active_option()
end

Agent --> caller : AgentStepResult(...)
deactivate Agent

@enduml
