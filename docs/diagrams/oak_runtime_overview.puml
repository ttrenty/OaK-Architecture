@startuml
title OaKAgent.step(...): top-level runtime overview

hide footbox
skinparam shadowing false
skinparam SequenceMessageAlign center

actor caller
participant OaKAgent
participant Perception
participant ValueFunction
participant TransitionModel
participant ReactivePolicy

rnote over OaKAgent, ReactivePolicy
This stays at the four-interface layer.
It shows only the calls reached during one step(...),
not every method on each interface.
oak_runtime_sequence expands the same phases into Composite*
and fine-grained interface calls.
endrnote

caller -> OaKAgent : step(time_step)

group 1. Perceive
  OaKAgent -> Perception : update(...)
  Perception --> OaKAgent : subjective_state
end

group 2. Learn [when a previous transition exists]
  OaKAgent -> ValueFunction : update(transition)
  ValueFunction --> OaKAgent : td_errors
  OaKAgent -> ReactivePolicy : update(transition, td_errors)
  OaKAgent -> TransitionModel : update(transition)
end

group 3. Grow
  OaKAgent -> ValueFunction : utility_scores()
  ValueFunction --> OaKAgent : utility_scores
  OaKAgent -> Perception : discover_and_rank_features(...)
  Perception --> OaKAgent : ranked_feature_ids
  group when ranked_feature_ids exist
    OaKAgent -> Perception : generate_subtasks(...)
    Perception --> OaKAgent : subtasks
    group when subtasks exist
      OaKAgent -> ReactivePolicy : ingest_subtasks(...)
    end
  end
  OaKAgent -> ReactivePolicy : integrate_options()
  OaKAgent -> TransitionModel : integrate_option_models()
end

group 4. Plan
  OaKAgent -> TransitionModel : plan(subjective_state, value_function, budget)
  TransitionModel --> OaKAgent : planning_update
  OaKAgent -> ReactivePolicy : apply_planning_update(...)
end

group 5. Act
  OaKAgent -> ReactivePolicy : select_action(subjective_state, threshold)
  ReactivePolicy --> OaKAgent : (action, active_option_id)
end

group 6. Maintain
  OaKAgent -> ValueFunction : observe_usage(...)
  OaKAgent -> ValueFunction : curate()
  ValueFunction --> OaKAgent : curation_decision
  group when curation drops something
    OaKAgent -> Perception : remove_features(...)
    OaKAgent -> ReactivePolicy : remove_subtasks(...)
    OaKAgent -> ReactivePolicy : remove_options(...)
    OaKAgent -> TransitionModel : remove_option_models(...)
    OaKAgent -> ValueFunction : remove(...)
  end
end

OaKAgent --> caller : AgentStepResult(...)

@enduml
