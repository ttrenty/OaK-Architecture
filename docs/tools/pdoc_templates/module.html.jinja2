    {% if module.modulename == "oak_architecture" %}
        <h2>Architecture Guide</h2>
        <ul>
            <li><a href="#diagram-gallery">Diagram Gallery</a></li>
            <li><a href="#what-you-must-implement">What You Must Implement</a></li>
            <li><a href="#diagram-to-code-mapping">Diagram-To-Code Mapping</a></li>
            <li><a href="#step-walkthrough">Step Walkthrough</a></li>
            <li><a href="#helper-methods">Helper Methods</a></li>
            <li><a href="#implementation-order">Implementation Order</a></li>
            <li><a href="#repository-examples">Repository Examples</a></li>
